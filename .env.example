# Optional browser setting. Leave empty to use RMWC's existing clinic enquiry handoff.
# This must be a deployed, reviewed HTTPS submit-case endpoint, never a database URL/key.
VITE_CASE_SUBMIT_URL=

# Server-only Supabase Edge Function secrets (set with Supabase secrets, not VITE_ variables):
# SUPABASE_URL is supplied by the platform.
# SUPABASE_SERVICE_ROLE_KEY is supplied by the platform; never expose it in a browser.
# ALLOWED_ORIGINS=https://your-approved-domain.example
# SUBMISSIONS_ENABLED=false
# Enable submissions only after approved rate limiting, consent, caseworker routing and privacy review.
